module completions {

  export extern rx [
    --help(-h)                # Print help
  ]

  export extern "rx install" [
    --help(-h)                # Print help
  ]

  export extern "rx list" [
    --help(-h)                # Print help
  ]

  export extern "rx run" [
    --help(-h)                # Print help
  ]

}

export use completions *

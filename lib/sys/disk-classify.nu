# Pure disk-path classification shared by `sys-disk` and `sys-audit`.
#
# This is deliberately a module of pure functions with no `export def main`, so
# both validate scripts and both commands can load it. The logic used to live as
# a closure inside `sys-disk`'s `main`, which made it impossible to assert -- the
# only disk checks in validate.nu passed against an EMPTY tree.
#
# No I/O happens here. Classification is NAME matching over path segments, not a
# content or provenance check. That is the same model `sys-disk` always used; it
# is cheap because it runs on rows that a single `gdu` pass already produced.
#
# PRECEDENCE IS DELIBERATE and identical in both profiles:
#   1. worktree  -- a worktree holds a real checkout AND its own target/. Never
#                   lump it with rebuildable space; removing one can discard
#                   uncommitted work.
#   2. git       -- same reasoning, .git is history, not build output.
#   3. profile rules, most-specific first.
#   4. source    -- the catch-all. Never a deletion candidate.
#
# Report-only in every consumer. Nothing in this file deletes anything.

# Directory names whose contents are regenerated by a build or install step
# rather than authored. Kept verbatim from the old inline list so existing
# `sys-disk` output does not shift.
const REBUILDABLE = [
  target node_modules dist build out .next .nuxt .svelte-kit .cache
  .venv venv __pycache__ .pytest_cache .mypy_cache .turbo .parcel-cache
  .gradle .terraform coverage
]

# Top-level caches the OS or a tool regenerates on next use. Distinct from
# REBUILDABLE because nothing needs to be rebuilt -- the next run just makes it
# again. `.cache` also appears in REBUILDABLE, but the home profile checks this
# list first, so it lands here.
const HOME_CACHE = [".cache" ".npm"]

const HOME_VM = [".minibox" "minibox" "omarchy-vm" "Virtual Machines" "libvirt" "vagrant"]
const HOME_CONTAINER = [".docker" ".colima" "colima" ".lima" "lima" "minikube"]
const HOME_MEDIA = ["Movies" "Music" "Pictures"]
const ARCHIVE_EXT = [
  .zip .tar .gz .tgz .bz2 .xz .7z .rar .dmg .iso .pkg .jar .war
]

# Paths under these trees are per-application state that macOS manages. They are
# categorised separately rather than called `rebuildable`, because deleting a
# container can cost sign-in tokens and local databases, not just a rebuild.
const APPDATA_MARKERS = [
  "Library/Application Support" "Library/Containers" "Library/Group Containers"
]

def _segs [path: string] {
  $path | split row "/"
}

def _any-seg [path: string, names: list<string>] {
  (_segs $path) | any {|s| $s in $names}
}

def _has-marker [path: string, markers: list<string>] {
  $markers | any {|m| $path | str contains $m}
}

# [nu_lib] Classify one path. Pure: no filesystem access, no flags beyond the two
# arguments, so it is cheap to call once per row.
export def classify-disk-path [--path: string, --profile: string = "dev"] {
  let p = $path

  if (_any-seg $p ["worktrees" ".worktrees"]) {
    if $profile == "home" { return "source" } else { return "worktree" }
  }

  if (_any-seg $p [".git"]) {
    if $profile == "home" { return "source" } else { return "git" }
  }

  if $profile == "home" {
    # App containers first: `Application Support/X/Caches` is app state, and
    # calling it `cache` would make it look cheaper to delete than it is.
    if (_has-marker $p $APPDATA_MARKERS) { return "appdata" }
    if (_has-marker $p ["Library/Caches"]) { return "cache" }
    if (_any-seg $p $HOME_CACHE) { return "cache" }
    if (_any-seg $p $HOME_VM) { return "vm" }
    if (_any-seg $p $HOME_CONTAINER) { return "container" }
    if (_any-seg $p $HOME_MEDIA) { return "media" }
    if ($ARCHIVE_EXT | any {|e| $p | str ends-with $e}) { return "archive" }
    if (_any-seg $p $REBUILDABLE) { return "rebuildable" }
    return "source"
  }

  if (_any-seg $p $REBUILDABLE) { return "rebuildable" }
  "source"
}

# [nu_lib] The categories a profile can emit, in report order. Single source of
# truth: the old code hardcoded this list in two places, so a new category could
# be classified but never summarised.
export def category-names [--profile: string = "dev"] {
  if $profile == "home" {
    ["cache" "rebuildable" "vm" "container" "archive" "media" "appdata" "source"]
  } else {
    ["rebuildable" "worktree" "git" "source"]
  }
}
